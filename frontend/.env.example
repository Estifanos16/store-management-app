# Backend API base URL (no trailing slash, no /api prefix).
# Read by src/services/api/client.ts.
#
# - .env.development  -> local backend (expo start)
# - .env.production   -> deployed Render backend (EAS Build / expo export)
# - .env.local        -> personal overrides (gitignored)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
