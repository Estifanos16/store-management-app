    "dotenv": "^16.1.0",
    "fastify": "^5.2.1",
    "pino": "^9.1.0",
    "pino-pretty": "^13.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
